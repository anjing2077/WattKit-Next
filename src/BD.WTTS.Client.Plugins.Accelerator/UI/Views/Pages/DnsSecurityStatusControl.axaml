<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.DnsSecurityStatusControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BD.WTTS.UI.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:DnsSecurityStatusViewModel"
    mc:Ignorable="d">
    <ScrollViewer
        Padding="20"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- 标题 -->
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="DNS 污染防护监控" />

            <!-- 状态指示灯 -->
            <Border
                Padding="24,20"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock
                        FontSize="48"
                        Text="{Binding StatusIcon}" />
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="当前状态" />
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{Binding StatusColor}"
                            Text="{Binding StatusText}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="实时更新 · 每 2 秒刷新" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 统计卡片 -->
            <UniformGrid Columns="3" Rows="1">
                <Border
                    Margin="0,0,8,0"
                    Padding="20,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#3b82f6"
                            Text="{Binding TotalQueries}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="总查询次数" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="4,0"
                    Padding="20,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#ef4444"
                            Text="{Binding TotalBlocked}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="拦截次数 (恶意)" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="8,0,0,0"
                    Padding="20,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#f59e0b"
                            Text="{Binding TotalWarnings}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="告警次数 (疑似)" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 最近诊断 -->
            <Border
                Padding="20,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="最近一次解析诊断" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="域名:" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{Binding LastHost}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="诊断:" />
                        <TextBlock
                            FontSize="12"
                            Text="{Binding LastDiagnostic}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phase 7: 通道级统计 -->
            <Border
                Padding="20,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="7 通道解析状态" />
                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        CanUserSortColumns="False"
                        FontSize="12"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding ChannelStats}"
                        MinHeight="80">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="40"
                                Binding="{Binding TypeIcon}"
                                Header="类型" />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding ChannelId}"
                                Header="通道" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding SuccessCount}"
                                Header="成功" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding FailCount}"
                                Header="失败" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding SuccessRate}"
                                Header="成功率" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding AvgLatency}"
                                Header="平均延迟" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding LastIp}"
                                Header="最近 IP" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="🔒 Socket 级 (硬编码 IP, 免疫 DNS 污染, 权重×2)  🔓 传统通道 (权重×1)" />
                </StackPanel>
            </Border>

            <!-- 拦截记录列表 -->
            <Border
                Padding="20,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="最近拦截/告警记录" />
                        <Button
                            Padding="12,4"
                            HorizontalAlignment="Right"
                            Classes="Accent"
                            Click="ResetButton_Click"
                            Content="重置统计" />
                    </StackPanel>
                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        CanUserSortColumns="False"
                        FontSize="12"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding RecentEvents}"
                        MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Time}"
                                Header="时间" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding Host}"
                                Header="域名" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Verdict}"
                                Header="裁决" />
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Quorum}"
                                Header="票数" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Diagnostic}"
                                Header="诊断信息" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding BlockedIps}"
                                Header="拦截 IP" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 防护层级说明 -->
            <Border
                Padding="20,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="5 层防护架构" />
                    <TextBlock FontSize="12" Text="L1: 用户自定义 DNS 服务器 (DoH/UDP)" />
                    <TextBlock FontSize="12" Text="L2: 7 通道并行解析 (2 传统 + 5 Socket 级 DoH/DoT) + 2.2s 硬超时 + 加权投票" />
                    <TextBlock FontSize="12" Text="L3.1: RFC5735/6890 Bogon/Martian 黑名单 (25 条 CIDR) + ASN 450 种子 (Tor/C&C/代理 VPS)" />
                    <TextBlock FontSize="12" Text="L3.2: 多数投票 (quorum/2+1) + DNSSEC RRSIG RSA/ECDsa 密码学验签加权" />
                    <TextBlock FontSize="12" Text="L3.3: 30 天指纹锚点 (SHA-256 信任记忆, 连续 2 次建立)" />
                    <TextBlock FontSize="12" Text="L4: hosts 文件完整性守护 (SHA-256 哈希链防篡改)" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="协议: GPL-3.0 · 0 新 NuGet 依赖 · 纯 BCL 密码学" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
